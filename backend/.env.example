# Copy to backend/.env and fill in. Never commit .env.

# Set to "production" on a live site: required secrets, HTTPS header, and no development shortcuts.
FLASK_ENV=development

# Both required in production (the app refuses to start without them). Use two DIFFERENT random values of 32+ characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Password of the admin account admin@taskpilot.dev.
# - First start with an empty database: the admin is created with this password.
# - Production with an older database that still has the published password "Admin@12345": the app will not start until
#   this is set; it then replaces the old password.
# In development, if unset, a local admin is created with a fixed password that is printed once in the terminal.
ADMIN_PASSWORD=

# DATABASE_URL defaults to a local SQLite file. For PostgreSQL on Render/Railway:
# DATABASE_URL=postgresql://user:pass@host/db

# Only if another website must call the API from the browser (comma separated). Leave empty otherwise: the pages and the
# API are served by this same app, so no cross-site access is needed. "*" is not accepted.
# CORS_ORIGINS=https://app.example.com

# Behind a host's proxy (Render, Railway, Nginx): how many proxies are in front, so rate limits see the real visitor.
# TRUST_PROXY=1

# A shared demo Member account on the login page (member@taskpilot.dev), for showing the app off. Off by default.
# There is never an Admin demo. Anyone can sign in to it, so keep nothing private in a demo deployment.
# DEMO_MODE=1
# DEMO_MEMBER_PASSWORD=Member@12345

# Sign-in limits (attempts per 15 minutes) and sign-ups (per hour). Counted in memory per worker.
# LOGIN_LIMIT_PER_EMAIL=8
# LOGIN_LIMIT_PER_IP=30
# SIGNUP_LIMIT_PER_IP=10
